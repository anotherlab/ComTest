<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ComTest"
             x:Class="ComTest.BufferPanel" x:DataType="local:BufferViewModel">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid Margin="20,18" ColumnDefinitions="Auto,*,Auto">
        <Border Background="#172F39" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
          <TextBlock Text="{Binding Direction}" FontSize="12" FontWeight="Bold" Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:BufferPanel}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" />
          <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="2" Classes="quiet" Content="Clear" Click="ClearClicked" Padding="12,6"
                VerticalAlignment="Center" ToolTip.Tip="Clear this display buffer and its byte counters" />
      </Grid>
      <Border Grid.Row="1" Background="#0E1829" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1">
        <Grid ColumnDefinitions="68,224,*" Margin="20,10">
          <TextBlock Text="OFFSET" Classes="eyebrow" FontSize="10" LetterSpacing="1" />
          <TextBlock Grid.Column="1" Text="HEX" Classes="eyebrow" FontSize="10" LetterSpacing="1" />
          <TextBlock Grid.Column="2" Text="ASCII" Classes="eyebrow" FontSize="10" LetterSpacing="1" />
        </Grid>
      </Border>
      <Grid Grid.Row="2" MinHeight="120">
        <ScrollViewer x:Name="DataScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid Margin="20,12" ColumnDefinitions="68,224,*" MinWidth="390" VerticalAlignment="Top">
            <SelectableTextBlock Text="{Binding Offsets}" Classes="bytes" Foreground="#6D829E" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Hex}" Classes="bytes"
                                 Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:BufferPanel}}" />
            <SelectableTextBlock Grid.Column="2" Text="{Binding Ascii}" Classes="bytes" Foreground="#DCE6F5" />
          </Grid>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsHitTestVisible="False">
          <TextBlock Text="— — —" FontFamily="{StaticResource MonoFont}" FontSize="24" Foreground="#3D506B" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
          <TextBlock Text="HEX + ASCII · 8 BYTES PER ROW" Classes="eyebrow" FontSize="9" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
        <StackPanel Spacing="9">
          <ProgressBar Value="{Binding Count}" Maximum="5000" Height="3" MinHeight="3" Background="#22324A"
                       Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:BufferPanel}}" />
          <TextBlock Text="{Binding Totals}" FontSize="11" Classes="muted" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
